# Copy to .env, fill in, then:  set -a; . ./.env; set +a
# .env is gitignored. NEVER commit real tokens or keys.

# ---- Invo auth (see README "Getting your Invo JWT") ----
INVO_REFRESH_TOKEN=
INVO_ACCESS_TOKEN=
INVO_RATE_LIMIT=220            # per-process budget per 5 min (Invo hard limit: 250 / 5 min / IP)

# ---- Mode ----
TRADING_MODE=paper             # paper | live   (live ALSO requires: python bot.py --live)
VENUE=hyperliquid              # hyperliquid (perps) | binance (spot, long-only)

# ---- Sizing / risk ----
TRADE_ALLOCATION_PCT=0.05      # margin per trade as fraction of equity
MAX_TRADE_AMOUNT_USDT=50
MIN_TRADE_AMOUNT_USDT=10
MAX_OPEN_POSITIONS=8
MAX_LEVERAGE=5                 # perps only; spot is always 1x
LONG_ONLY=false                # forced true for VENUE=binance
CIRCUIT_BREAKER_PCT=0.30       # halt when equity is 30% below starting equity
CIRCUIT_BREAKER_ACTION=flatten # flatten (close all, then halt) | halt (stop opening only)
MAX_ENTRY_DRIFT_PCT=0.02       # skip if price moved >2% from the trader's entry
MAX_SLIPPAGE_PCT=0.01          # live market-order slippage bound
MIRROR_EXISTING_ON_START=false # don't enter trades that were already open when first seen
CLOSE_CONFIRM_POLLS=2          # trade must be gone N polls before we close

# ---- Polling / files ----
POLL_INTERVAL=60
WATCHED_PORTFOLIOS_FILE=approved_portfolios.json
WATCHED_PORTFOLIOS=            # extra comma-separated portfolio IDs, added to the screener's list
STATE_FILE=state/bot_state.json
FILLS_LOG=state/fills.jsonl
LOG_FILE=state/bot.log
PAPER_STARTING_BALANCE=1000

# ---- Live: Hyperliquid (API/agent wallet ONLY -- cannot withdraw) ----
HL_ACCOUNT_ADDRESS=
HL_API_WALLET_PRIVATE_KEY=

# ---- Live: Binance spot (key MUST have withdrawals disabled; bot verifies) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=
